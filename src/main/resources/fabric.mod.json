{
  "schemaVersion": 1,
  "id": "lumenechallenge",
  "version": "${version}",
  "name": "ChallengeMod",
  "description": "The mod adds a system of randomly generated goals, hidden conditions, challenges, and unique modifiers that change the usual gameplay experience.",
  "authors": [
    "LumeneCore"
  ],
  "contact": {
    "homepage": "https://modrinth.com/user/LumeneCore",
    "sources": "https://github.com/lumenecore/ChallengeMod"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lumenechallenge.LumeneChallengeMod"
    ],
    "client": [
      "com.lumenechallenge.client.LumeneChallengeClient"
    ],
    "modmenu": [
      "com.lumenechallenge.client.layout.LumeneChallengeModMenuIntegration"
    ]
  },
  "mixins": [
    "lumenechallenge.mixins.json"
  ],
  "depends": {
    "minecraft": "1.21.5",
    "java": ">=21",
    "fabricloader": ">=0.16.14",
    "fabric-api": "*"
  },
  "icon": "assets/lumenechallenge/icon.png"
}